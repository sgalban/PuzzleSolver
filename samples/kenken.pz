grid(4, 4) {
  repeat(0, 3) {
    constraint unique(1 to 4) in row $0
  }

  repeat(0, 3) {
    constraint unique(1 to 4) in col $0
  }

  constraint addsTo(4) in cells [cell(0, 0), cell(0, 1)]
  constraint multTo(96) in cells [
    cell(0, 2),
    cell(0, 3),
    cell(1, 2),
    cell(1, 3),
    cell(2, 2)
  ]
  constraint multTo(12) in cells [
    cell(1, 0),
    cell(1, 1),
    cell(2, 0)
  ]
  constraint addsTo(10) in cells [
    cell(2, 1),
    cell(3, 1),
    cell(3, 2),
    cell(3, 3),
    cell(2, 3)
  ]
}