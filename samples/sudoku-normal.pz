grid(9, 9) {
  repeat(0, 8) {
    constraint unique(1 to 9) in row $0
  }
  repeat(0, 8) {
    constraint unique(1 to 9) in col $0
  }
  repeat(0, 2) {
    repeat(0, 2) {
        constraint unique(1 to 9) in subgrid(($0 * 3, $1 * 3), 3, 3)
    }
  }

  init cell(0, 0) with 5
  init cell(0, 1) with 3
  init cell(0, 4) with 7
  init cell(1, 0) with 6
  init cell(1, 3) with 1
  init cell(1, 4) with 9
  init cell(1, 5) with 5
  init cell(2, 1) with 9
  init cell(2, 2) with 8
  init cell(2, 7) with 6
  init cell(3, 0) with 8
  init cell(3, 4) with 6
  init cell(3, 8) with 3
  init cell(4, 0) with 4
  init cell(4, 3) with 8
  init cell(4, 5) with 3
  init cell(4, 8) with 1
  init cell(5, 0) with 7
  init cell(5, 4) with 2
  init cell(5, 8) with 6
  init cell(6, 1) with 6
  init cell(6, 6) with 2
  init cell(6, 7) with 8
  init cell(7, 3) with 4
  init cell(7, 4) with 1
  init cell(7, 5) with 9
  init cell(7, 8) with 5
  init cell(8, 4) with 8
  init cell(8, 7) with 7
  init cell(8, 8) with 9
} 